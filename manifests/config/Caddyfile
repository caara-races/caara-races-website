:8080

# Proxy oauth2-proxy endpoints (login, callback, etc.)
handle /oauth2/* {
	reverse_proxy localhost:4180
}

# Protected: require OIDC authentication for /members/*
handle /members/* {
	forward_auth localhost:4180 {
		uri /oauth2/auth
		header_up X-Forwarded-Uri {http.request.uri}
		header_up X-Forwarded-Proto https
		copy_headers X-Auth-Request-User X-Auth-Request-Email

		@unauthorized status 401
		handle_response @unauthorized {
			redir * /oauth2/sign_in?rd=https://{http.request.host}{http.request.uri}
		}
	}
	root * /srv
	file_server
}

# Public: serve everything else without authentication
handle {
	root * /srv
	file_server
}
