<p>These are the repeaters used to support our race safety nets. The locations
shown are only approximate.</p>

<table class="striped data-table">
  <tr>
    <th>Callsign</th>
    <th>Frequency</th>
    <th>Offset</th>
    <th>Tone</th>
    <th>Location</th>
  </tr>

{% for repeater in repeaters %}
  <tr>
    <td>{{ repeater[1].callsign | upcase }}</td>
    <td>{{ repeater[1].frequency }}</td>
    <td>{{ repeater[1].offset }}</td>
    <td>{{ repeater[1].tone }}</td>
    <td><a href="{{ repeater[1].location | googleMapUrl }}">{{ repeater[1].location.address }}</a></td>
  </tr>
{% endfor %}
</table>

{% assign map_id = "repeater-map" %}
{% assign map_title = "Repeater Map" %}
{% assign course_url = "" %}
{% assign checkpoints_url = "" %}
{% assign all_repeaters = true %}
{% include "map.liquid" %}
