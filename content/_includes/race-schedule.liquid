{% assign prev_year = schedule_year | minus: 1 %}
{% assign next_year = schedule_year | plus: 1 %}

{% assign has_prev = false %}
{% assign has_next = false %}
{% for yd in collections.raceYears %}
  {% if yd.year == prev_year %}{% assign has_prev = true %}{% endif %}
  {% if yd.year == next_year %}{% assign has_next = true %}{% endif %}
{% endfor %}

<div class="year-nav noprint">
  <span>
  {% if has_prev %}
    <a href="/race/{{ prev_year }}/">&laquo; {{ prev_year }}</a>
  {% else %}
    <span class="disabled">&laquo; {{ prev_year }}</span>
  {% endif %}
  </span>
  <span><a href="/race/{{ schedule_year }}/races.ics">Add to calendar</a></span>
  <span>
  {% if has_next %}
    <a href="/race/{{ next_year }}/">{{ next_year }} &raquo;</a>
  {% else %}
    <span class="disabled">{{ next_year }} &raquo;</span>
  {% endif %}
  </span>
</div>

{% assign current_year = "now" | date: "%Y" | plus: 0 %}
{% assign now_ts = "now" | date: "%s" %}

<table class="race-schedule striped">
  <thead>
    <tr>
      <th scope="col">Date</th>
      <th scope="col">Description</th>
      <th scope="col">Start time</th>
      <th scope="col">Location</th>
      <th scope="col" class="noprint">Links</th>
    </tr>
  </thead>
  <tbody>
{% for race in schedule_races %}
{% assign asset_base = race.page.inputPath | raceAssetBase %}
{% assign map_path = asset_base | append: race.page.fileSlug | append: ".pdf" %}
{% assign race_ts = race.data.date | date: "%s" %}
{% assign past_race = race_ts < now_ts %}
  <tr{% if schedule_year == current_year and past_race %} class="past-race"{% endif %}>
    <td>{{ race.data.date | date: "%b&nbsp;%d (%a)" }}</td>
    <td>
      <a href="{{ race.page.url }}">{{ race.data.title }}</a>
{% if schedule_year == current_year and past_race != true and race.data.race.want %}
      <p class="noprint">Needs {{race.data.race.want}} additional volunteers</p>
{% endif %}
    </td>
    <td>{{ race.data.date | date: "%H:%M&nbsp;%p", "America/New_York" }}</td>
    <td><a href="{{ race.data.race.start | googleMapUrl }}">{{ race.data.race.start | formatAddress: ", " }}</a></td>
    <td class="links noprint">
      <ul>
  {% if race.data.race.url %}
    <li><a title="YuKanRun Page" href="{{ race.data.race.url }}"><img class="icon" src="/image/web.png"></a></li>
  {% else %}
    <li><img class="icon" src="/image/web-grey.png"></li>
  {% endif %}
  {% if map_path | fileExists %}
    <li><a title="Course and checkpoint map" href="{{ map_path }}"><img class="icon" src="/image/map.png"></a></li>
  {% else %}
    <li><img class="icon" src="/image/map-grey.png"></li>
  {% endif %}
      </ul>
    </td>
  </tr>
{% endfor %}
</tbody>
</table>

