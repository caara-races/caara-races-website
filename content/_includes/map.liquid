{% assign map_id = map_id | default: "race-map" %}
{% assign map_title = map_title | default: "Course Map and Checkpoints" %}

<link rel="stylesheet" href="/css/map.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.fullscreen@3.0.2/Control.FullScreen.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">

<section class="noprint">
<h2>{{ map_title }}</h2>
<div id="{{ map_id }}" class="leaflet-map"></div>
</section>

<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js"></script>
{% if course_url != "" %}
<script src="https://cdn.jsdelivr.net/npm/leaflet-gpx@1.7.0/gpx.min.js"></script>
{% endif %}
<script src="https://cdn.jsdelivr.net/npm/leaflet.fullscreen@3.0.2/Control.FullScreen.js"></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script>
(function () {
  var map = L.map('{{ map_id }}', { fullscreenControl: true });

  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  }).addTo(map);

  {% if course_url != "" %}
  var coursePromise = new Promise(function (resolve) {
    var gpx = new L.GPX('{{ course_url | htmlBaseUrl }}', {
      async: true,
      gpx_options: { parseElements: ['track', 'route'] },
      marker_options: {
        startIconUrl: null,
        endIconUrl: null,
        shadowUrl: null
      },
      polyline_options: {
        color: '#4078c0',
        weight: 3
      }
    });
    gpx.on('loaded', function (e) {
      resolve({ layer: gpx, bounds: e.target.getBounds() });
    });
    gpx.on('error', function () {
      resolve(null);
    });
  });
  {% else %}
  var coursePromise = Promise.resolve(null);
  {% endif %}

  {% if checkpoints_url != "" %}
  var checkpointsPromise = fetch('{{ checkpoints_url | htmlBaseUrl }}')
    .then(function (r) { return r.text(); })
    .then(function (xml) {
      var doc = new DOMParser().parseFromString(xml, 'application/xml');
      var wpts = doc.getElementsByTagName('wpt');
      var markers = [];
      Array.from(wpts).forEach(function (wpt) {
        var lat = parseFloat(wpt.getAttribute('lat'));
        var lon = parseFloat(wpt.getAttribute('lon'));
        var nameEl = wpt.getElementsByTagName('name')[0];
        var descEl = wpt.getElementsByTagName('desc')[0];
        var name = nameEl ? nameEl.textContent.trim() : '';
        var desc = descEl ? descEl.textContent.trim() : '';
        var marker;
        if (name === 'START') {
          marker = L.circleMarker([lat, lon], {
            radius: 8,
            color: 'black',
            fillColor: '#67e639',
            fillOpacity: 1.0
          });
        } else if (name === 'FINISH') {
          marker = L.circleMarker([lat, lon], {
            radius: 8,
            color: 'black',
            fillColor: '#e63946',
            fillOpacity: 1.0
          });
        } else {
          marker = L.marker([lat, lon]);
        }
        markers.push(marker);
        if (name) {
          marker.bindTooltip(name, { permanent: true, direction: 'top' });
        }
        if (desc) {
          marker.bindPopup(desc);
        }
      });
      return markers.length > 0 ? { markers: markers, bounds: L.featureGroup(markers).getBounds() } : null;
    })
    .catch(function () { return null; });
  {% else %}
  var checkpointsPromise = Promise.resolve(null);
  {% endif %}

  var mapRepeaters = [
    {% if all_repeaters %}
    {% for pair in repeaters %}
    {% assign key = pair[0] %}
    {% assign r = pair[1] %}
    {% assign coords = repeaterCoords[key] %}
    {% if coords %}
    {% if r.display %}{% assign rlabel = r.display %}{% else %}{% assign rlabel = r.callsign | upcase %}{% endif %}
    {
      label: {{ rlabel | json }},
      callsign: {{ r.callsign | upcase | json }},
      frequency: {{ r.frequency | json }},
      offset: {{ r.offset | json }},
      tone: {{ r.tone | json }},
      location: {{ r.location.address | json }},
      lat: {{ coords.lat }},
      lon: {{ coords.lon }}
    },
    {% endif %}
    {% endfor %}
    {% else %}
    {% for pair in race.repeaters %}
    {% assign slug = pair[1] %}
    {% assign r = repeaters[slug] %}
    {% assign coords = repeaterCoords[slug] %}
    {% if r and coords %}
    {% if r.display %}{% assign rlabel = r.display %}{% else %}{% assign rlabel = r.callsign | upcase %}{% endif %}
    {
      label: {{ rlabel | json }},
      callsign: {{ r.callsign | upcase | json }},
      frequency: {{ r.frequency | json }},
      offset: {{ r.offset | json }},
      tone: {{ r.tone | json }},
      location: {{ r.location.address | json }},
      lat: {{ coords.lat }},
      lon: {{ coords.lon }}
    },
    {% endif %}
    {% endfor %}
    {% endif %}
  ];

  var repeaterCluster = L.markerClusterGroup({ maxClusterRadius: 20 });
  mapRepeaters.forEach(function (r) {
    var marker = L.marker([r.lat, r.lon], {
      icon: L.divIcon({
        className: 'repeater-icon',
        iconSize: [16, 16],
        iconAnchor: [8, 8]
      })
    });
    marker.bindTooltip(r.label, { permanent: true, direction: 'top' });
    marker.bindPopup(
      '<table>' +
      '<tr><th>Callsign</th><td>' + r.callsign + '</td></tr>' +
      '<tr><th>Frequency</th><td>' + r.frequency + '</td></tr>' +
      '<tr><th>Offset</th><td>' + r.offset + '</td></tr>' +
      '<tr><th>Tone</th><td>' + r.tone + '</td></tr>' +
      '<tr><th>Location</th><td>' + r.location + '</td></tr>' +
      '</table>'
    );
    repeaterCluster.addLayer(marker);
  });

  Promise.all([coursePromise, checkpointsPromise]).then(function (results) {
    var bounds = null;
    results.forEach(function (r) {
      if (r && r.bounds) bounds = bounds ? bounds.extend(r.bounds) : r.bounds;
    });
    if (repeaterCluster.getLayers().length > 0) {
      var rBounds = repeaterCluster.getBounds();
      bounds = bounds ? bounds.extend(rBounds) : rBounds;
    }
    if (bounds && bounds.isValid()) {
      map.fitBounds(bounds, { padding: [30, 30] });
    }
    results.forEach(function (r) {
      if (!r) return;
      if (r.layer) {
        r.layer.addTo(map);
      }
      if (r.markers) {
        r.markers.forEach(function (m) { m.addTo(map); });
      }
    });
    repeaterCluster.addTo(map);
  });
}());
</script>
