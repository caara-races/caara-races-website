<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
  <meta name="description" content="Cape Ann Amateur Radio Association provides volunteer radio communication support for races and events in the Cape Ann region of Massachusetts.">
  <meta name="theme-color" content="#4078c0">

  <!-- Open Graph tags for social sharing -->
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="Cape Ann Amateur Radio Association provides volunteer radio communication support for races and events in the Cape Ann region of Massachusetts.">
  <meta property="og:type" content="website">

  <title>{{ title }}</title>
  <link rel="stylesheet" href="/css/reset.css" />
  <link rel="stylesheet" href="/css/custom.css" />
</head>
<body>
  <header class="site-header">
    <div class="site-header-org">Cape Ann Amateur Radio Association</div>
    <h1>Race &amp; Event Support</h1>
  </header>

  <!--
    The links in the top navigation menu are ordered by their `weight`
    attribute. This defaults to `100` (from `content/_data/weight.json`), which
    means that pages *without* a weight will appear after items with a `weight`
    less than 100. The sort order for items of the same weight is unspecified,
    so if you want a particular ordering, set the weight values as appropriate.
  -->
  {% assign pages = collections.page | sort: 'data.weight' -%}
  <nav class="site-nav noprint" aria-label="Main navigation">
    <ul class="nav-main">
      {% for item in pages %}
        {% assign prefix = page.url | slice: 0, item.url.size %}
        <li {% if item.url == "/" %}{% if page.url == "/" %}class="active"{% endif %}{% elsif prefix == item.url %}class="active"{% endif %}><a href="{{ item.url }}">{{ item.data.short_title | default: item.data.title }}</a></li>
      {% endfor %}
    </ul>

    <ul class="nav-external">
      {% assign members_prefix = page.url | slice: 0, 9 %}
      {% if members_prefix == "/members/" %}
        <li><a href="/oauth2/sign_out?rd=https%3A%2F%2Fauth.oddbit.com%2Frealms%2Fcaara-races%2Fprotocol%2Fopenid-connect%2Flogout%3Fclient_id%3Dcaara-races-website%26post_logout_redirect_uri%3Dhttps%253A%252F%252Fcaara-races-dev.oddbit.com%252F">Log out</a></li>
      {% endif %}
      <li><a href="https://caara.net/">CAARA</a></li>
    </ul>
  </nav>

  <div class="page-title">
    <h1>{{ title }}</h1>
  </div>

  <main class="page-content">
  {{ content }}
  </main>

  <footer>
    Copyright &copy; {% year %} Cape Ann Amateur Radio Association |
    Revision: <a href="{{ repository.url }}/commit/{{ vc.revision }}">{{ vc.revision | slice: 0, 10 }}</a> @ {{ vc.date }}
    <span class="noprint"> |
    <a href="{{ repository.url }}/blob/{{ repository.ref }}/{{ page.inputPath }}?plain=1">View page source</a> |
    <a href="{{ repository.url }}/edit/{{ repository.ref }}/{{ page.inputPath }}">Suggest changes</a>
    </span>
  </footer>
</body>
</html>
