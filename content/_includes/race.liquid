---
layout: base
---

{% assign asset_base = page.inputPath | raceAssetBase %}
{% assign cover_image_path = asset_base | append: "cover.jpg" %}
{% assign map_path = asset_base | append: page.fileSlug | append: ".pdf" %}
{% assign course_path = asset_base | append: page.fileSlug | append: ".gpx" %}
{% assign checkpoints_path = asset_base | append: page.fileSlug | append: "-checkpoints.gpx" %}

<section class="raceinfo">
<table class="raceinfo">
  <tr>
    <th>When</th>
    <td>
      {{ date | date: "%b %d, %Y (%a)"}}
      <a class="noprint" href="race.ics">Add to calendar</a>
    </td>
  </tr>
  <tr>
    <th>Start time</th><td>{{ date | date: "%H:%M %p", "America/New_York"}}</td>
  </tr>
  <tr>
    <th>Start location</th><td><a href="{{ race.start | googleMapUrl }}">{{ race.start | formatAddress: "<br/>", "Start" }}</a></td>
  </tr>
  {% if race.finish %}
  <tr>
    <th>Finish location</th><td><a href="{{ race.finish | googleMapUrl }}">{{ race.finish | formatAddress: "<br/>", "Finish" }}</a></td>
  </tr>
  {% endif %}
  <tr>
    <th>Frequencies</th><td>Primary: {{ repeaters[race.frequency.primary] | formatRepeater }}</td>
  </tr>
  <tr>
    <th></th><td>Backup: {{ repeaters[race.frequency.backup] | formatRepeater }}</td>
  </tr>
</table>
</section>

<section class="racelinks noprint">
<ul>
  {% if race.url %}
    <li><a href="{{ race.url }}">YuKanRun Page</a></li>
  {% endif %}
  {% if map_path | fileExists %}
    <li><a href="{{ map_path }}">Course and checkpoint map</a></li>
  {% endif %}
  {% if course_path | fileExists %}
    <li><a href="{{ course_path }}">Course GPX</a></li>
  {% endif %}
  {% if checkpoints_path | fileExists %}
    <li><a href="{{ checkpoints_path }}">Checkpoints GPX</a></li>
  {% endif %}
</ul>
</section>

<section class="racemain">
{{ content }}

{% assign course_url = "" %}
{% if course_path | fileExists %}{% assign course_url = course_path %}{% endif %}
{% assign checkpoints_url = "" %}
{% if checkpoints_path | fileExists %}{% assign checkpoints_url = checkpoints_path %}{% endif %}
{% if course_url != "" or checkpoints_url != "" %}
{% include "map.liquid" %}
{% endif %}
</section>

<section class="contacts">
<h2>Emergency contacts</h2>

{% for townslug in race.towns %}
{% assign town = towns[townslug] %}
{% if town %}
  <h3>{{ townslug | townName: town }}</h3>
<ul>
{% for contact in town.contacts %}
    <li><strong>{{ contact.name }}</strong>: {{ contact.number }}
{% endfor %}
</ul>
{% endif %}
{% endfor %}
</section>

<section class="staffing">
<h2>Staffing</h2>

{% if race.want %}
<p class="wantnote">We are in need of {{ race.want }} additional volunteers for
this event. Please email <a href="mailto:kevinlyonsk1kl@gmail.com">Kevin,
K1KML</a> if you can help.</p>
{% endif %}

{% if volunteers %}
  <table class="striped">
    <tr>
      <th>Role</th>
      <th>Location</th>
      <th>Callsign</th>
      <th>Name</th>
      <th>On station</th>
    </tr>
{% for aro in volunteers %}
{% assign role_key = aro.Role | downcase %}
<tr {% if aro.Callsign == blank %}class="unassigned"{% endif %}>
    <td>{{ rolenames[aro.Role] | default: aro.Role }}</td>
    <td>{% if race.checkpoints[role_key].address %}<a href="{{ race.checkpoints[role_key] | googleMapUrl }}">{{ race.checkpoints[role_key].address }}</a><br/>{{ race.checkpoints[role_key].position }}{% endif %}</td>
{% if aro.Callsign != blank %}
    <td>{{ aro.Callsign | hamDbTooltip }}</td>
    <td>{{ aro.Name }}</td>
{% else %}
{% for i in (1..2) %}
    <td><img title="No volunteer is assigned to this checkpoint" class="icon" src="/image/warning-small.png"/></td>
{% endfor %}
{% endif %}
    <td>{{ aro["On station"] }}</td>
  </tr>
{% endfor %}
  </table>

  <p><strong>Checkpoint Miles are Approximate</strong>. Use Cross-Streets to identify your location for emergency assistance.</p>
{% else %}
  <p>Race details are not available at this time.</p>
{% endif %}
</section>
