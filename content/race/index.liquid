---
title: Race Schedule
tags: page
layout: page
weight: 10
---

{% assign current_year = "now" | date: "%Y" %}
<p class="noprint"><a href="/race/{{ current_year }}/races.ics">Add to calendar</a></p>

{% assign sorted_races = collections.race | sort: 'data.date' %}
{% assign now_ts = "now" | date: "%s" %}

<table class="race-schedule">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Date</th>
      <th scope="col">Description</th>
      <th scope="col">Start time</th>
      <th scope="col">Location</th>
      <th scope="col" class="noprint">Links</th>
    </tr>
  </thead>
  <tbody>
{% assign race_index = 0 %}
{% for race in sorted_races %}
{% assign race_year = race.data.date | date: "%Y" %}
{% if race_year == current_year %}
{% assign race_index = race_index | plus: 1 %}
{% assign asset_base = race.page.inputPath | raceAssetBase %}
{% assign map_path = asset_base | append: race.page.fileSlug | append: ".pdf" %}
{% assign course_path = asset_base | append: race.page.fileSlug | append: ".gpx" %}
{% assign race_ts = race.data.date | date: "%s" %}
  <tr{% if race_ts < now_ts %} class="past-race"{% endif %}>
    <td>{{ race_index }}</td>
    <td>{{ race.data.date | date: "%b %d (%a)" }}</td>
    <td>
      <a href="{{ race.page.url }}">{{ race.data.title }}</a>
      {% if race.data.race.want %}
      <p class="noprint">Needs {{race.data.race.want}} additional volunteers</p>
      {% endif %}
    </td>
    <td>{{ race.data.date | date: "%H:%M %p", "America/New_York" }}</td>
    <td><a href="{{ race.data.race.location.address | replaceNewlines: ", " | googleMapSearch }}">{{ race.data.race.location | formatAddress: ", " }}</a></td>
    <td class="icons noprint">
      <ul>
  {% if race.data.race.url %}
    <li><a title="YuKanRun Page" href="{{ race.data.race.url }}"><img src="/image/web.png"></a></li>
  {% else %}
    <li><img src="/image/web-grey.png"></li>
  {% endif %}
  {% if map_path | fileExists %}
    <li><a title="Map" href="{{ map_path }}"><img src="/image/map.png"></a></li>
  {% else %}
    <li><img src="/image/map-grey.png"></li>
  {% endif %}
  {% if course_path | fileExists %}
    <li><a title="GPX" href="{{ course_path }}"><img src="/image/path.png"></a></li>
  {% else %}
    <li><img src="/image/path-grey.png"></li>
  {% endif %}
      </ul>
    </td>
  </tr>
{% endif %}
{% endfor %}
</tbody>
</table>

