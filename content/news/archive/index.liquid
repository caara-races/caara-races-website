---
title: News Archive
layout: page
---

{% for yearGroup in collections.newsYears %}
<h2>{{ yearGroup.year }}</h2>

<table class="data-table striped news-archive">
  <thead>
    <tr>
      <th scope="col">Date</th>
      <th scope="col">Author</th>
      <th scope="col">Title</th>
    </tr>
  </thead>
  <tbody>
  {% for post in yearGroup.posts %}
    <tr>
      <td>{{ post.date | date: "%Y-%m-%d", "UTC" }}</td>
      <td>{{ post.data.author }}</td>
      <td><a href="{{ post.url }}">{{ post.data.title }}</a></td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endfor %}
